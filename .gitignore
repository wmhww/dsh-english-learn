# Dependencies (this project has none at runtime, but npm/pnpm may create these)
node_modules/
package-lock.json
pnpm-lock.yaml
yarn.lock

# Downloaded upstream datasets — ~240 MB, reproducible from scripts/sources.mjs.
# Kept outside the package, but ignore it here too so a checkout that put it
# inside the repo never gets committed.
.data-cache/
*.part

# Build output. `lib/` is generated by `npm run build` and is what dsh loads;
# it is ignored so a commit never carries a stale bundle. `npm publish` still
# includes it because `files` in package.json lists it explicitly.
lib/

# Editor / OS noise
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# Logs and scratch
*.log
npm-debug.log*
.tmp*/
